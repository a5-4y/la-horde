---
import { getCollection, render } from 'astro:content';

const members = (await getCollection('bureau')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  members.map(async (m) => ({ ...m, Content: (await render(m)).Content })),
);
---

<section id="bureau">
  <div class="container">
    <h2>Le bureau</h2>
    <p class="subtitle">La meute qui fait tourner le club</p>
    <div class="grid grid-4">
      {rendered.map((m) => (
        <article class="card member">
          <div class="avatar">
            {m.data.photo
              ? <img src={m.data.photo} alt={m.data.name} />
              : <span>{m.data.name.replace(/[^A-Z]/g, '').slice(0, 2) || '?'}</span>
            }
          </div>
          <h3>{m.data.name}</h3>
          <p class="role">{m.data.role}</p>
          <div class="bio"><m.Content /></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .member {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--violet-700), var(--violet-500));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 2rem;
    color: white;
    letter-spacing: 0.05em;
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .member h3 {
    font-size: 1.4rem;
    color: var(--text);
    margin-bottom: 0.25rem;
  }
  .role {
    color: var(--violet-400);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
  }
  .bio {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .bio :global(p) { margin: 0; }
</style>
