---
import { club } from '../data/club';

const groups = [club.tarifs.abonnes, club.tarifs.unite];
---

<section id="tarifs">
  <div class="container">
    <h2>Tarifs</h2>
    <p class="subtitle">Adhésion & licence — saison 2025 / 2026</p>

    {groups.map((group) => (
      <div class="tier">
        <div class="tier-head">
          <h3 class="tier-title">{group.title}</h3>
          <span class="tier-sub">{group.subtitle}</span>
        </div>
        <div class="tier-row">
          {group.items.map((t) => (
            <div class={`price-card${t.highlight ? ' price-card--highlight' : ''}`}>
              {t.highlight && <span class="badge">Populaire</span>}
              <h4>{t.label}</h4>
              <div class="price">
                <span class="amount">{t.price}</span>
                <span class="unit">{t.unit}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <p class="note">
      La licence FFForce est nécessaire pour participer aux compétitions officielles.
      L'abonnement seul suffit pour s'entraîner à la salle.
    </p>
  </div>
</section>

<style>
  .tier {
    margin-bottom: 3rem;
  }
  .tier:last-of-type { margin-bottom: 0; }

  .tier-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .tier-title {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--violet-300);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .tier-sub {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .tier-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .price-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2rem 1.5rem;
    text-align: center;
    position: relative;
    transition: transform 0.2s, border-color 0.2s;
  }
  .price-card:hover {
    transform: translateY(-4px);
    border-color: var(--violet-500);
  }
  .price-card--highlight {
    border-color: var(--violet-500);
    box-shadow: 0 0 40px rgba(139, 92, 246, 0.25);
    background: linear-gradient(180deg, var(--bg-card), rgba(139, 92, 246, 0.08));
  }
  .badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--gold);
    color: #1a1428;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: 3px;
  }
  .price-card h4 {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin-bottom: 1.5rem;
    min-height: 2.6em;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
  }
  .amount {
    font-family: var(--font-display);
    font-size: 3.5rem;
    color: var(--violet-300);
    line-height: 1;
  }
  .unit {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .note {
    text-align: center;
    color: var(--text-muted);
    margin-top: 2rem;
    font-size: 0.9rem;
    max-width: 640px;
    margin-inline: auto;
    padding-inline: 1rem;
  }
</style>
