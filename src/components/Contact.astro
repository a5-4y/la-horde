---
import { club } from '../data/club';

const mapsUrl = `https://www.google.com/maps?q=${encodeURIComponent(club.address.mapsQuery)}&output=embed`;
---

<section id="contact">
  <div class="container">
    <h2>Contact & adresse</h2>
    <p class="subtitle">On t'attend à la salle</p>

    <div class="contact-grid">
      <div class="contact-info">
        <div class="info-block">
          <span class="label">Adresse</span>
          <p>
            <strong>{club.name}</strong><br />
            {club.address.street}<br />
            {club.address.postal} {club.address.city}
          </p>
        </div>

        <div class="info-block">
          <span class="label">Email</span>
          <p><a href={`mailto:${club.contact.email}`}>{club.contact.email}</a></p>
        </div>

        <div class="info-block">
          <span class="label">Instagram</span>
          <p>
            <a href={club.contact.instagramUrl} target="_blank" rel="noopener">
              @{club.contact.instagram}
            </a>
          </p>
        </div>

        <a href={`mailto:${club.contact.email}`} class="btn">Écris-nous</a>
      </div>

      <div class="map">
        <iframe
          src={mapsUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Localisation ${club.name}`}
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
    align-items: stretch;
  }
  @media (max-width: 800px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .info-block {
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--violet-500);
    border-radius: 4px;
  }
  .label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--violet-400);
    margin-bottom: 0.5rem;
  }
  .info-block p { color: var(--text); }
  .info-block a { word-break: break-word; }
  .contact-info .btn { align-self: flex-start; margin-top: 0.5rem; }
  .map {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    min-height: 400px;
  }
  .map iframe {
    width: 100%;
    height: 100%;
    min-height: 400px;
    border: 0;
    filter: hue-rotate(220deg) saturate(0.6) brightness(0.85);
  }
</style>
