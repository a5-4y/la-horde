---
import { getCollection, render } from 'astro:content';

const machines = (await getCollection('machines')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  machines.map(async (m) => ({ ...m, Content: (await render(m)).Content })),
);
---

<section id="machines">
  <div class="container">
    <h2>La salle</h2>
    <p class="subtitle">Matos de compétition — équipement en cours d'installation</p>
    <div class="grid grid-3">
      {rendered.map((m) => (
        <article class="card machine">
          <div class="photo">
            <img src={m.data.photo} alt={m.data.photoAlt} loading="lazy" />
            {m.data.count > 1 && <span class="count">×{m.data.count}</span>}
          </div>
          <div class="body">
            <span class="cat">{m.data.category}</span>
            <h3>{m.data.name}</h3>
            <div class="desc"><m.Content /></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .machine {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .photo {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--violet-900), var(--bg-elev));
    overflow: hidden;
    position: relative;
  }
  .count {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--gold);
    color: #1a1428;
    font-family: var(--font-display);
    font-size: 1.1rem;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .machine:hover .photo img { transform: scale(1.05); }
  .body { padding: 1.25rem 1.5rem 1.5rem; }
  .cat {
    display: inline-block;
    background: rgba(139, 92, 246, 0.15);
    color: var(--violet-300);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
    margin-bottom: 0.5rem;
  }
  .machine h3 {
    font-size: 1.4rem;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .desc {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .desc :global(p) { margin: 0; }
</style>
