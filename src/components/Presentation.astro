---
import { club } from '../data/club';
---

<section id="presentation">
  <div class="container">
    <h2>Le club</h2>
    <p class="subtitle">Qui sommes-nous</p>
    <div class="grid-2">
      <div>
        <p class="lead">{club.description}</p>
        <p>
          Affiliés à la <strong>FFForce</strong> (Fédération Française de Force),
          nous préparons ensemble les compétitions régionales et nationales de
          <strong>powerlifting</strong>. Débutant·e ou compétiteur·rice
          confirmé·e, on t'accueille dans la meute.
        </p>
        <ul class="values">
          <li>🏋️ Matériel de compétition homologué IPF</li>
          <li>👥 Ambiance familiale, coaching entre membres</li>
          <li>🏆 Préparation compétitions FFForce</li>
          <li>📍 Accès facile Lyon / Villeurbanne</li>
        </ul>
      </div>
      <div class="quote">
        <p>« On n'est pas la plus grosse salle. On est la plus soudée. »</p>
        <span>— La Horde</span>
      </div>
    </div>
  </div>
</section>

<style>
  .grid-2 {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 800px) {
    .grid-2 { grid-template-columns: 1fr; }
  }
  .lead {
    font-size: 1.2rem;
    color: var(--text);
    margin-bottom: 1.5rem;
  }
  .values {
    list-style: none;
    margin-top: 2rem;
    display: grid;
    gap: 0.75rem;
  }
  .values li {
    padding: 0.75rem 1rem;
    background: var(--bg-elev);
    border-left: 3px solid var(--violet-500);
    border-radius: 4px;
  }
  .quote {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--violet-500);
    padding: 2rem;
    border-radius: 8px;
  }
  .quote p {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--violet-300);
    line-height: 1.3;
    margin-bottom: 1rem;
  }
  .quote span {
    color: var(--text-muted);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
